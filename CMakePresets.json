{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 22, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "${sourceDir}/cmake/gcc-arm-none-eabi.cmake",
      "cacheVariables": {
        "ARM_TOOLCHAIN_PATH": "D:/DevEnv/GNU-tools-for-STM32/bin",
        "CMAKE_TRY_COMPILE_PLATFORM_VARIABLES": "ARM_TOOLCHAIN_PATH",
        "CMAKE_MAKE_PROGRAM": "D:/CLion 2026.2.3.1/bin/ninja/win/x64/ninja.exe"
      }
    },
    {
      "name": "Debug",
      "displayName": "Debug (arm-none-eabi, -Og)",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "Release",
      "displayName": "Release (arm-none-eabi, -O2)",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    }
  ],
  "buildPresets": [
    { "name": "Debug", "configurePreset": "Debug" },
    { "name": "Release", "configurePreset": "Release" }
  ]
}
